# ---------------------------------------------------------------------------
# Copy to .env at the repo root for Docker Compose, and to Backend/.env for
# running the API directly:  cp .env.example .env
# ---------------------------------------------------------------------------

# Database credentials (Compose builds DATABASE_URL from these)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=choose_a_strong_database_password
POSTGRES_DB=url_shortener

# Connection string — only needed when running the backend outside Docker.
# Inside Compose this is assembled automatically from the values above.
DATABASE_URL=postgresql://postgres:choose_a_strong_database_password@localhost:5435/url_shortener

# Connection used by `prisma migrate` only. Migrations cannot run through a
# transaction pooler, so on a hosted database (e.g. Supabase) this is the
# direct/session connection while DATABASE_URL is the pooled one. Against a
# plain local Postgres both are identical.
DIRECT_URL=postgresql://postgres:choose_a_strong_database_password@localhost:5435/url_shortener

# Redis Connection URL (configured inside Docker automatically)
REDIS_URL=redis://localhost:6379

# JWT signing secret — must be at least 32 characters in production.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_cryptographically_secure_random_string

# Google OAuth Credentials (optional — shortening works signed out. Leave these
# blank and the API still boots; it just can't offer sign-in, so there is no
# dashboard and no private per-link stats.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Public URL Configuration — set these to your real domains when deploying.
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Number of reverse-proxy hops in front of the API. Defaults to 1 in
# production. Set to 0 if the API is exposed directly with no proxy.
TRUST_PROXY=1

# Next.js public config. NEXT_PUBLIC_* values are inlined into the browser
# bundle at build time, so changing this requires rebuilding the frontend.
NEXT_PUBLIC_API_URL=http://localhost:5000
