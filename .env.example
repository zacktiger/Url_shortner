# Database URL (only needed for direct local development. Inside Docker, this is configured automatically)
DATABASE_URL=postgresql://postgres:kshitij@localhost:5435/url_shortener

# Redis Connection URL (configured inside Docker automatically)
REDIS_URL=redis://localhost:6379

# JWT Token secret
JWT_SECRET=change_this_to_a_long_cryptographically_secure_random_string

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Public URL Configuration
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Next.js Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_BASE_URL=http://localhost:5000
