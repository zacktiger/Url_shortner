generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Pooled connection used by the running app. On Supabase this is the
  // transaction pooler (port 6543) with ?pgbouncer=true.
  url = env("DATABASE_URL")

  // Migrations can't run through a transaction pooler — it doesn't support the
  // prepared statements and advisory locks the migration engine needs. This
  // points at a direct/session connection instead. For local Postgres it is
  // simply the same URL as above.
  directUrl = env("DIRECT_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  googleId   String   @unique
  email      String   @unique
  name       String

  urls       Url[]

  createdAt  DateTime @default(now())
}

model Url {
  id         Int       @id @default(autoincrement())

  shortCode  String    @unique
  longUrl    String
  clicks     Int       @default(0)

  userId     Int?
  user       User?     @relation(fields: [userId], references: [id])

  analytics  Analytics[]

  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
}

model Analytics {
  id         Int      @id @default(autoincrement())

  urlId      Int
  url        Url      @relation(fields: [urlId], references: [id])

  country    String?
  device     String?
  browser    String?
  referrer   String?

  clickedAt  DateTime @default(now())

  @@index([urlId])
}